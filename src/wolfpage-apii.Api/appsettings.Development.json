{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "Server=.\\MSSQLSERVER01;Database=WolfPageDb;Trusted_Connection=True;TrustServerCertificate=True"
  },
  "Database": {
    "RunMigrationsOnStartup": true
  },
  "Swagger": {
    "Enabled": true
  },
  "Jwt": {
    "Issuer": "WolfPage.Api",
    "Audience": "WolfPage.Portal",
    "AccessTokenMinutes": 60
  },
  "Auth": {
    "RequireConfirmedEmail": false,
    "EmailConfirmationTokenHours": 24
  },
  "AuthSeed": {
    "Enabled": true,
    "WorkspaceName": "WolfPage Demo",
    "WorkspaceEmail": "admin@wolfpage.local",
    "AdminEmail": "admin@wolfpage.local",
    "AdminFullName": "WolfPage Admin"
  },
  "Portal": {
    "BaseUrl": "http://localhost:4200"
  },
  "GoogleAuth": {
    "ClientId": ""
  },
  "Email": {
    "Provider": "Log",
    "FromAddress": "donotreply@wolfpage.local"
  },
  "AzureCommunicationServices": {
    "ConnectionString": ""
  },
  "Messaging": {
    "Provider": "RabbitMq"
  },
  "AzureServiceBus": {
    "ConnectionString": "",
    "FullyQualifiedNamespace": "",
    "QueueName": "site.generate"
  },
  "RabbitMq": {
    "HostName": "localhost",
    "Port": 5672,
    "VirtualHost": "/wolfpage"
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:4200",
      "http://127.0.0.1:4200"
    ]
  }
}

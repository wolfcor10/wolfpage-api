{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Database": {
    "RunMigrationsOnStartup": false
  },
  "Jwt": {
    "Issuer": "WolfPage.Api",
    "Audience": "WolfPage.Portal",
    "AccessTokenMinutes": 60
  },
  "AuthSeed": {
    "Enabled": false
  },
  "RabbitMq": {
    "Port": 5672,
    "VirtualHost": "/wolfpage"
  },
  "Cors": {
    "AllowedOrigins": []
  }
}

{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Database": {
    "RunMigrationsOnStartup": false
  },
  "Swagger": {
    "Enabled": false
  },
  "Jwt": {
    "Issuer": "WolfPage.Api",
    "Audience": "WolfPage.Portal",
    "AccessTokenMinutes": 60
  },
  "Auth": {
    "RequireConfirmedEmail": false,
    "EmailConfirmationTokenHours": 24
  },
  "AuthSeed": {
    "Enabled": false
  },
  "Portal": {
    "BaseUrl": "https://yellow-meadow-02f12e80f.7.azurestaticapps.net"
  },
  "GoogleAuth": {
    "ClientId": ""
  },
  "Email": {
    "Provider": "Log",
    "FromAddress": "donotreply@wolfpage.local"
  },
  "AzureCommunicationServices": {
    "ConnectionString": ""
  },
  "Messaging": {
    "Provider": "RabbitMq"
  },
  "AzureServiceBus": {
    "ConnectionString": "",
    "FullyQualifiedNamespace": "",
    "QueueName": "site.generate"
  },
  "Storage": {
    "ConnectionString": "",
    "ServiceUri": "",
    "ContainerName": "wolfpage-media"
  },
  "RabbitMq": {
    "Port": 5672,
    "VirtualHost": "/wolfpage"
  },
  "Cors": {
    "AllowedOrigins": []
  }
}
